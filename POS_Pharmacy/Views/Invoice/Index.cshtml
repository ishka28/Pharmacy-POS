@model POS_Pharmacy.Models.InvoiceViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharmacy POS System - Billing Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .theme-bg {
        background-color: #00716b;
        }

        .theme-text {
        color: #00716b;
        }

        .theme-border {
        border-color: #00716b;
        }

        .theme-hover:hover {
        background-color: #027057;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen">

    <header class="theme-bg text-white px-6 py-3 flex justify-between items-center shadow-sm">
        <div class="flex items-center space-x-2">
            <div class="bg-white text-[#005F54] w-6 h-6 rounded flex items-center justify-center font-black text-lg">✚</div>
            <h1 class="text-lg font-bold tracking-wider uppercase flex items-center">
                PHARMACY POS SYSTEM
                <span class="text-sm font-normal normal-case ml-3 opacity-95 border-l border-white/30 pl-3">Billing Panel</span>
            </h1>
        </div>
        <div class="flex items-center space-x-1.5 text-sm font-medium">
            <i class="fa-solid fa-mortar-pestle text-base"></i>
            <span>PharmaCare</span>
        </div>
    </header>

    <main class="max-w-7xl mx-auto p-6 space-y-6">
        <form id="posForm" method="post">

            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
                <div class="flex items-center space-x-2 border-b pb-3 mb-4">
                    <i class="fa-solid fa-calendar-days theme-text"></i>
                    <h2 class="text-md font-bold text-gray-700 tracking-wider uppercase">Common Fields</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Date</label>
                        <input type="date" asp-for="Date" id="Date" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600 cursor-pointer" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Invoice No</label>
                        <input type="text" asp-for="InvoiceNo" id="InvoiceNo" readonly class="w-full border bg-gray-50 rounded px-3 py-2 text-sm text-gray-500 focus:outline-none" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Doctor Name</label>
                        <input type="text" asp-for="DoctorName" id="DoctorName" placeholder="Dr. Rajesh Sharma" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mt-4 pt-4 border-t border-dashed border-gray-100">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Patient Mobile</label>
                        <input type="tel" asp-for="PatientMobile" id="PatientMobile" placeholder="Enter Mobile Number" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Patient Name</label>
                        <input type="text" asp-for="PatientName" id="PatientName" placeholder="Enter Patient Name" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">DOB</label>
                        <input type="date" asp-for="DOB" id="DOB" asp-format="{0:yyyy-MM-dd}" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600 cursor-pointer" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Gender</label>
                        <select asp-for="Gender" id="Gender" class="w-full border rounded px-3 py-2 text-sm bg-white focus:outline-none focus:ring-1 focus:ring-teal-600">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 mt-6">
                <div class="flex items-center space-x-2 border-b pb-3 mb-4">
                    <i class="fa-solid fa-capsules theme-text"></i>
                    <h2 class="text-md font-bold text-gray-700 tracking-wider uppercase">Billing Items</h2>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-9 gap-2 items-end">

                    <div class="col-span-1 md:col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Generic Name</label>
                        <input type="text" id="txtGeneric" oninput="onGenericChange()" placeholder="Type generic name" class="w-full border rounded px-2 py-1.5 text-sm bg-white focus:outline-none focus:ring-1 focus:ring-teal-600" />
                    </div>

                    <div class="col-span-1 md:col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Brand Name</label>
                        <select id="ddlBrand" disabled onchange="onBrandChange()" class="w-full border rounded px-2 py-1.5 text-sm bg-white focus:outline-none disabled:bg-gray-50">
                            <option value="">Select Brand</option>
                        </select>
                    </div>

                    <div class="col-span-1">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Dose</label>
                        <select id="ddlDose" disabled onchange="onDoseChange()" class="w-full border rounded px-2 py-1.5 text-sm bg-white focus:outline-none disabled:bg-gray-50">
                            <option value="">Select Dose</option>
                        </select>
                    </div>

                    <div class="col-span-1">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Selling Price ($)</label>
                        <input type="number" id="inputPrice" value="0.00" step="0.01" class="w-full border rounded px-2 py-1.5 text-sm focus:outline-none" />
                    </div>

                    <div class="col-span-1">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Direction</label>
                        <select id="inputDirection" class="w-full border rounded px-2 py-1.5 text-sm bg-white focus:outline-none">
                            <option value="">Select</option>
                            <option value="Nocte">Nocte</option>
                            <option value="Mane">Mane</option>
                            <option value="TDS">TDS</option>
                            <option value="SOS">SOS</option>
                            <option value="Q4H">Q4H</option>
                            <option value="Q6H">Q6H</option>
                        </select>
                    </div>

                    <div class="col-span-1 flex space-x-1">
                        <div class="w-2/3">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Duration</label>
                            <select id="inputDurationUnit" class="w-full border rounded px-1 py-1.5 text-xs bg-white focus:outline-none">
                                <option value="Days">Days</option>
                                <option value="Weeks">Weeks</option>
                                <option value="Months">Months</option>
                            </select>
                        </div>
                        <div class="w-1/3">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">&nbsp;</label>
                            <input type="number" id="inputDurationVal" min="0" value="0" class="w-full border rounded px-1 py-1.5 text-sm focus:outline-none text-center no-spinner" />
                        </div>
                    </div>

                    <div class="col-span-1">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">No. of Pills</label>
                        <input type="number" id="inputPills" min="0" value="0" placeholder="0" class="w-full border rounded px-2 py-1.5 text-sm focus:outline-none" />
                    </div>

                    <div class="col-span-1">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Sub Total ($)</label>
                        <input type="text" id="inputSubTotal" value="0.00" readonly class="w-full border bg-gray-50 rounded px-2 py-1.5 text-sm text-gray-500 focus:outline-none" />
                    </div>

                    <div class="col-span-2 md:col-span-1">
                        <button type="button" id="btnAddItem" class="w-full theme-bg text-white font-semibold text-sm py-1.5 rounded theme-hover transition duration-150 flex items-center justify-center space-x-1">
                            <i class="fa-solid fa-circle-plus"></i>
                            <span>Add Item</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="overflow-x-auto rounded-lg border border-gray-200 mt-6 shadow-sm bg-white">
                <table class="w-full border-collapse text-left text-sm text-gray-500">
                    <thead class="theme-bg text-white text-xs uppercase tracking-wider">
                        <tr>
                            <th class="px-4 py-3 font-semibold text-center w-12">#</th>
                            <th class="px-4 py-3 font-semibold">Description</th>
                            <th class="px-4 py-3 font-semibold">Selling Price ($)</th>
                            <th class="px-4 py-3 font-semibold">Dose</th>
                            <th class="px-4 py-3 font-semibold">Direction of Use</th>
                            <th class="px-4 py-3 font-semibold">Duration</th>
                            <th class="px-4 py-3 font-semibold text-center">Number of Pills</th>
                            <th class="px-4 py-3 font-semibold w-32">Sub Total ($)</th>
                            <th class="px-4 py-3 font-semibold text-center w-16">Action</th>
                        </tr>
                    </thead>
                    <tbody id="billingTableBody" class="divide-y divide-gray-200">
                    </tbody>
                </table>
            </div>

            <div class="flex flex-col md:flex-row items-center justify-between mt-6 bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                <div class="text-center md:text-left mb-4 md:mb-0">
                    <span class="text-xs uppercase text-gray-400 font-bold tracking-wider block">Invoice Total ($)</span>
                    <span id="txtInvoiceTotal" class="text-3xl font-black text-emerald-700 tracking-tight">0.00</span>
                </div>
                <div>
                    <button type="submit" class="bg-emerald-600 text-white font-bold px-8 py-3 rounded-lg shadow-md hover:bg-emerald-700 transition flex items-center space-x-2 text-base">
                        <i class="fa-regular fa-circle-check text-lg"></i>
                        <span>Complete Invoice Transaction</span>
                    </button>
                </div>
            </div>
        </form>
    </main>

    <script>
        const rawStockDb = @Html.Raw(ViewBag.AllStockJson != null ? ViewBag.AllStockJson : "[]");
        var billingItems = [];

        // 1. Triggers dynamically as the user types into the Generic Name box
        function onGenericChange() {
        var typedGeneric = document.getElementById('txtGeneric').value.trim().toLowerCase();
        var brandDropdown = document.getElementById('ddlBrand');
        var doseDropdown = document.getElementById('ddlDose');

        // Reset dependent drops immediately
        brandDropdown.innerHTML = '<option value="">Select Brand</option>';
        brandDropdown.disabled = true;
        doseDropdown.innerHTML = '<option value="">Select Dose</option>';
        doseDropdown.disabled = true;
        clearActiveInputs();

        if (typedGeneric === "") return;

        // Filter out unique brands that match what was typed
        var filteredBrands = [...new Set(rawStockDb
        .filter(s => s.GenericName.toLowerCase() === typedGeneric)
        .map(s => s.BrandName)
        )];

        if (filteredBrands.length > 0) {
        filteredBrands.forEach(brand => {
        var option = document.createElement('option');
        option.value = brand;
        option.text = brand;
        brandDropdown.appendChild(option);
        });
        brandDropdown.disabled = false;
        }
        }

        // 2. Triggers when a Brand is selected from the freshly loaded dropdown menu
        function onBrandChange() {
        var typedGeneric = document.getElementById('txtGeneric').value.trim().toLowerCase();
        var selectedBrand = document.getElementById('ddlBrand').value;
        var doseDropdown = document.getElementById('ddlDose');

        doseDropdown.innerHTML = '<option value="">Select Dose</option>';
        doseDropdown.disabled = true;
        clearActiveInputs();

        if (!selectedBrand) return;

        var filteredRecords = rawStockDb.filter(s =>
        s.GenericName.toLowerCase() === typedGeneric &&
        s.BrandName === selectedBrand
        );

        filteredRecords.forEach(stock => {
        var option = document.createElement('option');
        option.value = stock.StockId || stock.stockId;
        var exactDose = stock.Dose || stock.dose || "N/A";
        option.text = exactDose;
        option.setAttribute('data-dose', exactDose);
        option.setAttribute('data-price', stock.SellPrice || stock.sellPrice || 0);

        doseDropdown.appendChild(option);
        });

        doseDropdown.disabled = false;
        }

        // 3. Triggers when a Dose option is chosen
        function onDoseChange() {
        var doseDropdown = document.getElementById('ddlDose');
        var selectedOption = doseDropdown.options[doseDropdown.selectedIndex];

        if (!selectedOption.value) {
        clearActiveInputs();
        return;
        }

        var price = parseFloat(selectedOption.getAttribute('data-price')) || 0;
        document.getElementById('inputPrice').value = price.toFixed(2);

        calculateSubTotal();
        }

        function calculateSubTotal() {
        var price = parseFloat(document.getElementById('inputPrice').value) || 0;
        var pills = parseInt(document.getElementById('inputPills').value) || 0;
        var subTotal = price * pills;
        document.getElementById('inputSubTotal').value = subTotal.toFixed(2);
        }

        document.getElementById('inputPrice').addEventListener('input', calculateSubTotal);
        document.getElementById('inputPills').addEventListener('input', calculateSubTotal);

        function addBillingRow() {
        var genericName = document.getElementById('txtGeneric').value.trim();

        var brandSelect = document.getElementById('ddlBrand');
        var brandName = brandSelect.options[brandSelect.selectedIndex]?.value || "";

        var doseSelect = document.getElementById('ddlDose');
        var stockId = doseSelect.value;
        var dose = doseSelect.options[doseSelect.selectedIndex]?.getAttribute('data-dose') || "";

        var price = parseFloat(document.getElementById('inputPrice').value) || 0;
        var direction = document.getElementById('inputDirection').value;
        var durationUnit = document.getElementById('inputDurationUnit').value;
        var durationVal = parseInt(document.getElementById('inputDurationVal').value) || 0;
        var pills = parseInt(document.getElementById('inputPills').value) || 0;
        var subTotal = parseFloat(document.getElementById('inputSubTotal').value) || 0;

        if (genericName === "" || brandName === "" || stockId === "" || pills <= 0) {
        alert('Please enter a Generic Name, choose a Brand, Dose, and enter Pills count.');
        return;
        }

        // Clean layout description containing Brand, Generic, and Dose
        var completeDescription = `${brandName} (${genericName}) - ${dose}`;

        var Item = {
        ItemCode: stockId,
        Description: completeDescription,
        SellingPrice: price.toFixed(2).toString(),
        Dose: dose,
        DirectionOfUse: direction,
        DurationUnit: durationUnit,
        DurationValue: durationVal,
        NumberOfPills: pills.toString(),
        SubTotal: subTotal.toFixed(2).toString()
        };

        billingItems.push(Item);
        refreshBillingTable();
        clearInputFields();
        }

        document.getElementById('btnAddItem').addEventListener('click', addBillingRow);

        function removeBillingRow(index) {
        billingItems.splice(index, 1);
        refreshBillingTable();
        }

        function refreshBillingTable() {
        var tableBody = document.getElementById('billingTableBody');
        tableBody.innerHTML = "";
        var totalInvoiceSum = 0;

        for (var i = 0; i < billingItems.length; i++) {
        var item = billingItems[i];
        totalInvoiceSum += parseFloat(item.SubTotal) || 0;

        var htmlRow = '<tr class="hover:bg-gray-50">' +
        '<td class="px-4 py-3 text-center font-medium text-gray-900">' + (i + 1) + '</td>' +
        '<td class="px-4 py-3 font-medium text-gray-800">' + item.Description + '</td>' +
        '<td class="px-4 py-3">' + parseFloat(item.SellingPrice).toFixed(2) + '</td>' +
        '<td class="px-4 py-3">' + item.Dose + '</td>' +
        '<td class="px-4 py-3"><span class="bg-teal-50 text-teal-700 px-2 py-0.5 rounded text-xs font-semibold border border-teal-200">' + item.DirectionOfUse + '</span></td>' +
        '<td class="px-4 py-3">' + item.DurationValue + ' ' + item.DurationUnit + '</td>' +
        '<td class="px-4 py-3 text-center">' + item.NumberOfPills + '</td>' +
        '<td class="px-4 py-3 font-semibold text-gray-900">' + parseFloat(item.SubTotal).toFixed(2) + '</td>' +
        '<td class="px-4 py-3 text-center">' +
        '<button type="button" onclick="removeBillingRow(' + i + ')" class="text-red-500 hover:text-red-700 transition"><i class="fa-regular fa-trash-can text-lg"></i></button>' +
        '</td>' +
        '</tr>';

        tableBody.innerHTML += htmlRow;
        }

        document.getElementById('txtInvoiceTotal').innerText = totalInvoiceSum.toFixed(2);
        }

        function clearInputFields() {
        document.getElementById('txtGeneric').value = "";
        document.getElementById('ddlBrand').innerHTML = '<option value="">Select Brand</option>';
        document.getElementById('ddlBrand').disabled = true;
        document.getElementById('ddlDose').innerHTML = '<option value="">Select Dose</option>';
        document.getElementById('ddlDose').disabled = true;
        document.getElementById('inputPrice').value = "0.00";
        document.getElementById('inputDirection').value = "";
        document.getElementById('inputDurationUnit').value = "Days";
        document.getElementById('inputDurationVal').value = "0";
        document.getElementById('inputPills').value = "";
        document.getElementById('inputSubTotal').value = "0.00";
        }

        function clearActiveInputs() {
        document.getElementById('inputPrice').value = "0.00";
        document.getElementById('inputSubTotal').value = "0.00";
        }

        document.getElementById('posForm').addEventListener('submit', function(event) {
        event.preventDefault();

        if (billingItems.length === 0) {
        alert('Please add items to compile the invoice document grid structure first.');
        return;
        }

        var postData = {
        InvoiceNo: document.getElementById('InvoiceNo').value,
        Date: document.getElementById('Date').value || new Date().toISOString().split('T')[0],
        DoctorName: document.getElementById('DoctorName').value,
        PatientName: document.getElementById('PatientName').value,
        PatientMobile: document.getElementById('PatientMobile').value,
        DOB: document.getElementById('DOB').value || new Date().toISOString().split('T')[0],
        Gender: document.getElementById('Gender').value,
        InvoiceTotal: parseFloat(document.getElementById('txtInvoiceTotal').innerText) || 0,
        BillingItems: billingItems
        };

        fetch('Invoice/SaveInvoice', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(postData)
        })
        .then(response => response.json())
        .then(data => {
        if (data.success) {
        alert("Invoice generated and stock updated successfully!");
        billingItems = [];
        refreshBillingTable();
        clearInputFields();

        document.getElementById('PatientName').value = "";
        document.getElementById('PatientMobile').value = "";
        document.getElementById('DOB').value = "";
        document.getElementById('Gender').value = "";
        document.getElementById('DoctorName').value = "";
        document.getElementById('InvoiceNo').value = data.newInvoiceNo;
        } else {
        alert(data.message);
        }
        })
        .catch(error => {
        console.error("Error saving document:", error);
        alert("An operational failure occurred processing the submission loop sequence.");
        });
        });
    </script>
</body>
</html>