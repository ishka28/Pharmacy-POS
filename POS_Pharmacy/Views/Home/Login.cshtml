@page
@model POS_Pharmacy.Views.Home.LoginModel
@{
    Layout = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharmacy POS System - Account Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .theme-bg {
        background-color: #00716b;
        }

        .theme-text {
        color: #00716b;
        }

        .theme-border {
        border-color: #00716b;
        }

        .theme-hover:hover {
        background-color: #027057;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col justify-between">

    <header class="theme-bg text-white px-6 py-3 flex justify-between items-center shadow-sm w-full">
        <div class="flex items-center space-x-2">
            <div class="bg-white text-[#005F54] w-6 h-6 rounded flex items-center justify-center font-black text-lg">
                ✚
            </div>
            <h1 class="text-lg font-bold tracking-wider uppercase flex items-center">
                PHARMACY POS SYSTEM
                <span class="text-sm font-normal normal-case ml-3 opacity-95 border-l border-white/30 pl-3">User Login</span>
            </h1>
        </div>
        <div class="flex items-center space-x-1.5 text-sm font-medium">
            <i class="fa-solid fa-lock text-base"></i>
            <span>Login Form</span>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center p-6">
        <div class="w-full max-w-md">
            <form class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-5" onsubmit="event.preventDefault(); window.location.href='/Home/Purchasing';">

                <div class="text-center pb-2">
                    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-teal-50 text-[#00716b] mb-2">
                        <i class="fa-solid fa-user-clock text-xl"></i>
                    </div>
                    <h2 class="text-lg font-bold text-gray-700 uppercase tracking-wide">Welcome Back!</h2>
                    <p class="text-xs text-gray-400 mt-0.5">Please provide your credentials.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-gray-400"><i class="fa-regular fa-user text-sm"></i></span>
                        <input type="text" id="Username" name="Username" placeholder="Enter username" class="w-full border rounded pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                    </div>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="text-xs font-semibold text-gray-600">Password</label>
                        <a href="#" class="text-[11px] theme-text hover:underline font-medium">Forgot Password?</a>
                    </div>
                    <div class="relative flex items-center">
                        <span class="absolute left-3 text-gray-400"><i class="fa-solid fa-key text-sm"></i></span>
                        <input type="password" id="loginPassword" name="Password" placeholder="********" class="w-full border rounded pl-9 pr-10 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                        <button type="button" onclick="toggleVisibility()" class="absolute right-3 text-gray-400 hover:text-gray-600">
                            <i class="fa-regular fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="w-full theme-bg text-white font-bold py-2.5 rounded-lg shadow theme-hover transition flex items-center justify-center space-x-2 text-sm mt-2">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Login</span>
                </button>

                <div class="text-center pt-3 border-t border-gray-100">
                    <span class="text-xs text-gray-400">Not Logined Yet?</span>
                    <a href="/Home/Register" class="text-xs font-semibold theme-text hover:underline ml-1">Register Here</a>
                </div>

            </form>
        </div>
    </main>

    <script>
        function toggleVisibility() {
        const passField = document.getElementById('loginPassword');
        passField.type = passField.type === "password" ? "text" : "password";
        }
    </script>
</body>
</html>