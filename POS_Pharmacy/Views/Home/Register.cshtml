@{
    Layout = "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharmacy POS System - User Registration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .theme-bg {
        background-color: #00716b;
        }

        .theme-text {
        color: #00716b;
        }

        .theme-border {
        border-color: #00716b;
        }

        .theme-hover:hover {
        background-color: #027057;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen">

    <header class="theme-bg text-white px-6 py-3 flex justify-between items-center shadow-sm w-full">
        <div class="flex items-center space-x-2">
            <div class="bg-white text-[#005F54] w-6 h-6 rounded flex items-center justify-center font-black text-lg">✚</div>
            <h1 class="text-lg font-bold tracking-wider uppercase flex items-center">
                PHARMACY POS SYSTEM
                <span class="text-sm font-normal normal-case ml-3 opacity-95 border-l border-white/30 pl-3">User Registration</span>
            </h1>
        </div>
    </header>

    <main class="max-w-3xl mx-auto p-6 mt-6">
        <form method="post" action="/Home/Register" class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-6">

            <div class="flex items-center space-x-2 border-b pb-3">
                <i class="fa-solid fa-id-card theme-text text-lg"></i>
                <h2 class="text-md font-bold text-gray-700 tracking-wider uppercase">Create Account</h2>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="bg-red-50 border-l-4 border-red-500 p-3 text-red-700 text-sm rounded">
                    @ViewBag.Error
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">First Name</label>
                    <input type="text" id="FirstName" name="FirstName" placeholder="Enter first name" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Last Name</label>
                    <input type="text" id="LastName" name="LastName" placeholder="Enter last name" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Email Address</label>
                    <input type="email" id="Email" name="Email" placeholder="example@gmail.com" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Mobile Number</label>
                    <input type="tel" id="Mobile" name="Mobile" placeholder="+94 7X XXX XXXX" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
                    <input type="text" id="Username" name="Username" placeholder="Choose a unique username" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Password</label>
                    <div class="relative flex items-center">
                        <input type="password" id="txtPassword" name="Password" placeholder="********" class="w-full border rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-600" required />
                        <button type="button" onclick="togglePasswordVisibility('txtPassword')" class="absolute right-3 text-gray-400 hover:text-gray-600">
                            <i class="fa-regular fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                <a href="/Home/Login" class="text-sm font-medium theme-text hover:underline">Already have an account? Log In</a>
                <button type="submit" class="theme-bg text-white font-bold px-8 py-2.5 rounded-lg shadow-md theme-hover transition flex items-center space-x-2 text-sm">
                    <i class="fa-solid fa-user-check"></i>
                    <span>Register</span>
                </button>
            </div>

        </form>
    </main>

    <script>
        function togglePasswordVisibility(fieldId) {
        const field = document.getElementById(fieldId);
        field.type = field.type === "password" ? "text" : "password";
        }
    </script>
</body>
</html>